{
  "schema_version": 1,
  "package": "centralized-actions-workflows",
  "version": "v1.0.0",
  "source_repository": "{{REPOSITORY_OWNER}}/{{REPOSITORY_NAME}}",
  "reusable_workflows": [
    ".github/workflows/pr-policy.yml",
    ".github/workflows/pull-request.yml",
    ".github/workflows/quality.yml"
  ],
  "reusable_actions": [
    ".github/actions/verify-conventional-commits",
    ".github/actions/verify-pull-request-title",
    ".github/actions/verify-signed-off-by"
  ],
  "capabilities": {
    "maintenance-safety": {
      "status": "available",
      "enabled_by_default": false,
      "workflow": ".github/workflows/maintenance-safety.yml",
      "contract_version": 2,
      "required_inputs": ["repository", "head-sha", "pull-request-number", "central-repository", "central-ref"],
      "minimum_permissions": {
        "actions": "read",
        "contents": "read",
        "issues": "write",
        "pull-requests": "write"
      }
    },
    "maintenance-merge": {
      "status": "contract-only",
      "enabled_by_default": false,
      "workflow": ".github/workflows/merge-maintenance-pr.yml",
      "contract_version": 1,
      "required_inputs": ["repository", "head-sha", "pull-request-number"],
      "minimum_permissions": {
        "actions": "read",
        "contents": "read",
        "pull-requests": "read"
      }
    },
    "release-please": {
      "status": "contract-only",
      "enabled_by_default": false,
      "workflow": ".github/workflows/release-please.yml",
      "contract_version": 1,
      "required_inputs": ["repository", "release-config", "manifest-file"],
      "minimum_permissions": {
        "contents": "read",
        "pull-requests": "read"
      }
    },
    "weekly-tooling-updates": {
      "status": "contract-only",
      "enabled_by_default": false,
      "workflow": ".github/workflows/weekly-tooling-updates.yml",
      "contract_version": 1,
      "required_inputs": ["repository", "explicit-breaking"],
      "minimum_permissions": {
        "contents": "write",
        "issues": "read",
        "pull-requests": "write"
      }
    }
  },
  "ref_policy": {
    "type": "immutable",
    "allowed": ["semver-release-tag", "commit-sha"]
  },
  "runtime": {
    "registration_owner": "{{APP_REGISTRATION_OWNER}}",
    "installation_owner": "{{INSTALLATION_OWNER}}",
    "service_layout": {
      "repository": "{{REPOSITORY_OWNER}}/{{REPOSITORY_NAME}}",
      "release_ref": "immutable-package-ref",
      "consumer_adapter": "thin-repository-workflow"
    },
    "release_policy": {
      "type": "immutable",
      "allowed": ["semver-release-tag", "commit-sha"],
      "contract_versioning": "increment-and-release"
    },
    "roles": {
      "governance": {
        "identity": "governance",
        "events": ["pull_request", "check_run", "workflow_run", "branch_protection_rule"],
        "permissions": {
          "actions": "read",
          "checks": "write",
          "contents": "read",
          "metadata": "read",
          "pull-requests": "read",
          "statuses": "write"
        },
        "installation_scope": "selected-repositories",
        "token_mode": "installation",
        "ruleset_bypass": false,
        "secret_custody": "operator-only"
      },
      "reviewer": {
        "identity": "reviewer",
        "events": ["workflow_run"],
        "permissions": {
          "actions": "write",
          "metadata": "read",
          "pull-requests": "write"
        },
        "installation_scope": "selected-repositories",
        "token_mode": "installation",
        "ruleset_bypass": false,
        "secret_custody": "operator-only"
      },
      "writer": {
        "identity": "writer",
        "events": [],
        "permissions": {
          "actions": "read",
          "contents": "write",
          "metadata": "read",
          "pull-requests": "write"
        },
        "installation_scope": "selected-repositories",
        "token_mode": "installation",
        "ruleset_bypass": false,
        "secret_custody": "operator-only"
      }
    }
  }
}
